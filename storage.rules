rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function moderator() {
      return signedIn() && request.auth.token.moderator == true;
    }

    // Firestore metadata controls access to the stored image.
    // Pending images are visible only to their uploader and trusted moderators.
    match /locationPhotos/{locationId}/{uploaderUid}/{fileName} {
      function photoRecord() {
        return firestore.get(/databases/(default)/documents/locations/$(locationId)/photos/$(fileName)).data;
      }
      allow read: if signedIn() && (
        moderator()
        || photoRecord().status == "approved"
        || (request.auth.uid == uploaderUid && photoRecord().uploaderUid == uploaderUid)
      );
      allow create: if signedIn()
        && request.auth.uid == uploaderUid
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update: if false;
      allow delete: if moderator();
    }
  }
}